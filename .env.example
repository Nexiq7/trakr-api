# Secret used to sign JWT auth tokens. Generate one with:
#   openssl rand -base64 32
# Anyone who knows this value can mint valid tokens for any account, so treat it
# like a password and never reuse the example below.
# Note: wrap the value in quotes if it contains '#', or everything from the '#'
# onwards is read as a comment and silently dropped.
JWT_SECRET=change-me-to-a-long-random-string

# Free API key from https://thetvdb.com/api-information
TVDB_KEY=your-tvdb-api-key

# Where the database lives.
#
# The default is a local SQLite file — no account, no signup, nothing to
# provision. It's created for you by `bun run db:push`.
DATABASE_URL=file:./data/trakr.db
#
# To use Turso (or any libsql server) instead, point at it and add a token:
#   DATABASE_URL=libsql://your-database.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
#
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are still read as fallbacks, so existing
# deploys keep working unchanged.

# Allowed CORS origin(s) — where the frontend is served from.
# Comma-separate to allow more than one, e.g. https://trakr.app,https://www.trakr.app
ORIGIN=http://localhost:5173

# Port the API listens on (optional, defaults to 3007)
# PORT=3007
