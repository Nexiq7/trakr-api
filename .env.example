# Secret used to sign JWT auth tokens — any random string works. The backend
# refuses to start if it isn't set.
# Note: wrap the value in quotes if it contains '#', or everything from the '#'
# onwards is read as a comment and silently dropped.
JWT_SECRET=change-me-to-a-long-random-string

# Free API key from https://thetvdb.com/api-information
TVDB_KEY=your-tvdb-api-key

# Turso (libsql) database — create a free one at https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Allowed CORS origin(s) — where the frontend is served from.
# Comma-separate to allow more than one, e.g. https://trakr.app,https://www.trakr.app
ORIGIN=http://localhost:5173

# Port the API listens on (optional, defaults to 3007)
# PORT=3007
